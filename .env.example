# Copy to .env and fill in. .env is gitignored and never committed.

# TypeSafe / Jev API key, used by the server for incident arbitration.
# Without it the scoring engine runs on its own heuristics and Jev is simply absent.
JEV_API=

# Ohio: OHGO Public API key, free and instant. https://publicapi.ohgo.com/docs/registration
# Used only by the pipeline to read the camera list. Images need no key.
OHIODOT_API=

# Oregon: TripCheck API subscription key, free. https://apiportal.odot.state.or.us/
# Used only by the pipeline to read the camera inventory. Images need no key.
OREGONDOT_API=
